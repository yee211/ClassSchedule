# 生产 Docker 容器环境配置模板
# 复制为 deploy/.env 并修改对应敏感项
POSTGRES_PASSWORD=please-change-this-to-a-secure-db-password
# JWT 签名密钥，请替换为足够长的随机字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# 首次启动创建的默认账号，用于接管升级前的既有课表数据（登录凭证为邮箱）
DEFAULT_EMAIL=demo@example.com
DEFAULT_USERNAME=demo
DEFAULT_PASSWORD=demo1234

# AI 课表解析（OpenAI 兼容协议）；AI_API_KEY 留空则自动回退本地 Excel 解析
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=60000
