DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/class_schedule
POSTGRES_ADMIN_URL=postgresql://postgres:your_password@127.0.0.1:5432/postgres
# JWT 签名密钥，请替换为足够长的随机字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=please-change-this-to-a-long-random-string
# 登录令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
# 首次启动创建的默认账号，用于接管升级前的既有课表数据（登录凭证为邮箱）
DEFAULT_EMAIL=demo@example.com
DEFAULT_USERNAME=demo
DEFAULT_PASSWORD=demo1234

# AI 课表解析（OpenAI 兼容协议）。AI_API_KEY 留空时不报错，导入会自动回退到本地 Excel 解析
# 换厂商只需改下面三项，例如：
#   DeepSeek   https://api.deepseek.com/v1                deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   Kimi       https://api.moonshot.cn/v1                 moonshot-v1-8k
#   OpenAI     https://api.openai.com/v1                  gpt-4o-mini
#   本地 Ollama http://localhost:11434/v1                  qwen2.5:7b
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# ⚠ 请选用普通对话模型，不要用推理类模型（*-flash / *-reasoner / 带 thinking）。
#   实测同一份课表：deepseek-v4-flash 耗时 115s，deepseek-chat 仅 10.9s，输出完全一致。
#   推理模型把时间花在隐藏思考 token 上，且总耗时易超过 Nginx 默认 60s
#   proxy_read_timeout，导致生产环境 504。
# 单次请求超时（秒），超时后自动走兜底解析
AI_TIMEOUT_SECONDS=120
# 序列化后交给模型的字符上限，超出则截断，防止 token 爆量
AI_MAX_INPUT_CHARS=60000
